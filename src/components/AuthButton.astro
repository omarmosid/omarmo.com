---
const user = Astro.locals.user;

function getInitials(name: string | null | undefined, email: string): string {
	const source = name?.trim() || email;
	const parts = source.split(/\s+/).filter(Boolean);
	if (parts.length >= 2) return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
	return source.slice(0, 2).toUpperCase();
}

const displayName = user?.name?.trim() || user?.email;
const initials = user ? getInitials(user.name, user.email) : '';
const logoutRedirect = encodeURIComponent(Astro.url.pathname + Astro.url.search);
---

{
	user && (
		<auth-button class="relative inline-block">
			<button
				class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border border-border bg-surface text-sm font-bold text-content hover:border-accent hover:text-accent"
				type="button"
				aria-haspopup="menu"
				aria-expanded="false"
				aria-label={`Open user menu for ${displayName}`}
				data-auth-toggle
			>
				{user.avatarUrl ? <img class="h-full w-full object-cover" src={user.avatarUrl} alt="" loading="lazy" decoding="async" /> : initials}
			</button>

			<div
				class="absolute right-0 z-20 mt-2 hidden w-64 rounded-2xl border border-border bg-surface p-2 text-sm shadow-lg"
				role="menu"
				data-auth-menu
			>
				<div class="border-b border-border px-3 py-2">
					<p class="truncate font-semibold text-content">{displayName}</p>
					<p class="truncate text-xs text-muted">{user.email}</p>
				</div>

				<a class="block rounded-lg px-3 py-2 text-muted no-underline hover:bg-border/50 hover:text-accent" href="/_emdash/admin" role="menuitem">
					Dashboard
				</a>

				<form method="POST" action={`/_emdash/api/auth/logout?redirect=${logoutRedirect}`}>
					<button class="block w-full rounded-lg px-3 py-2 text-left text-muted hover:bg-border/50 hover:text-accent" type="submit" role="menuitem">
						Sign out
					</button>
				</form>
			</div>
		</auth-button>
	)
}

<script>
	class AuthButton extends HTMLElement {
		#button: HTMLButtonElement | null = null;
		#menu: HTMLElement | null = null;

		connectedCallback() {
			this.#button = this.querySelector('[data-auth-toggle]');
			this.#menu = this.querySelector('[data-auth-menu]');

			this.#button?.addEventListener('click', this.#toggleMenu);
			document.addEventListener('click', this.#closeOnOutsideClick);
			window.addEventListener('keydown', this.#closeOnEscape);
		}

		disconnectedCallback() {
			this.#button?.removeEventListener('click', this.#toggleMenu);
			document.removeEventListener('click', this.#closeOnOutsideClick);
			window.removeEventListener('keydown', this.#closeOnEscape);
		}

		#getOpen() {
			return this.#button?.getAttribute('aria-expanded') === 'true';
		}

		#setOpen(open: boolean) {
			this.#menu?.classList.toggle('hidden', !open);
			this.#button?.setAttribute('aria-expanded', open.toString());
		}

		#toggleMenu = (event: Event) => {
			event.stopPropagation();
			this.#setOpen(!this.#getOpen());
		};

		#closeOnOutsideClick = (event: Event) => {
			if (event.target instanceof Node && !this.contains(event.target)) this.#setOpen(false);
		};

		#closeOnEscape = (event: KeyboardEvent) => {
			if (event.key === 'Escape') this.#setOpen(false);
		};
	}

	if (!customElements.get('auth-button')) {
		customElements.define('auth-button', AuthButton);
	}
</script>
