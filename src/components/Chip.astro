---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href?: string;
}

const { href, class: className, ...props } = Astro.props;
const classes = [
	'rounded-full bg-surface-subtle px-2.5 py-1 text-xs font-medium text-muted no-underline',
	'hover:bg-accent-subtle-hover hover:text-accent-hover',
	className,
];
---

{
	href ? (
		<a class:list={classes} href={href} {...props}>
			<slot />
		</a>
	) : (
		<span class:list={classes} {...props}>
			<slot />
		</span>
	)
}
