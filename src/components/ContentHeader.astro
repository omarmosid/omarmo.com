---
import FormattedDate from './FormattedDate.astro';
import MetaDot from './MetaDot.astro';

interface Props {
	title: string;
	description?: string;
	kicker: string;
	date?: Date | string;
	readingTime?: string;
	updatedDate?: Date | string;
}

const { date, description, kicker, readingTime, title, updatedDate } = Astro.props;
const hasMeta = Astro.slots.has('meta');

// "Updated" only adds information when it is a different day from the publish date.
const isUpdated = Boolean(updatedDate) && new Date(updatedDate!).toDateString() !== (date ? new Date(date).toDateString() : '');
---

<header class="mb-12 border-b border-border pb-10">
	<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm font-medium text-muted">
		<span class="uppercase tracking-widest text-accent">{kicker}</span>
		{date && <MetaDot />}
		{date && <FormattedDate date={date} />}
		{readingTime && <MetaDot />}
		{readingTime && <span>{readingTime}</span>}
		{isUpdated && <MetaDot />}
		{isUpdated && <span>Updated <FormattedDate date={updatedDate!} /></span>}
	</div>
	<h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-balance text-content sm:text-5xl">{title}</h1>
	{description && <p class="mt-5 text-lg text-pretty text-muted sm:text-xl">{description}</p>}
	{
		hasMeta && (
			<div class="mt-6">
				<slot name="meta" />
			</div>
		)
	}
</header>
