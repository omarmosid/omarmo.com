---
import FormattedDate from './FormattedDate.astro';

interface Props {
	title: string;
	description?: string;
	kicker: string;
	date?: Date | string;
	readingTime?: string;
	updatedDate?: Date | string;
}

const { date, description, kicker, readingTime, title, updatedDate } = Astro.props;
const hasMeta = Astro.slots.has('meta');
---

<header class="mb-10 border-b border-border pb-8">
	<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-medium text-muted">
		<span class="uppercase tracking-widest text-accent">{kicker}</span>
		{date && <span class="text-border">/</span>}
		{date && <FormattedDate date={date} />}
		{readingTime && <span>· {readingTime}</span>}
		{updatedDate && <span>· Updated <FormattedDate date={updatedDate} /></span>}
	</div>
	<h1 class="mt-3 text-4xl font-bold tracking-tight text-balance text-content sm:text-5xl">{title}</h1>
	{description && <p class="mt-4 text-lg text-pretty text-muted">{description}</p>}
	{
		hasMeta && (
			<div class="mt-5">
				<slot name="meta" />
			</div>
		)
	}
</header>
