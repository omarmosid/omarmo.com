---
import { MENU_LINKS, SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer class="mt-20 border-t border-border">
	<div class="container-page flex flex-col gap-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
		<p>&copy; {today.getFullYear()} {SITE_AUTHOR}</p>
		<nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Footer navigation">
			{MENU_LINKS.map((link) => <a class="no-underline hover:text-accent" href={link.href}>{link.label}</a>)}
		</nav>
	</div>
</footer>
