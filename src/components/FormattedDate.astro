---
interface Props {
	date: Date | string;
}

const { date: dateValue } = Astro.props;
const date = dateValue instanceof Date ? dateValue : new Date(dateValue);
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-GB', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
