---
import { entrySlug, type NoteEntry } from '../lib/emdash-content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	note: NoteEntry;
}

const { note } = Astro.props;
const slug = entrySlug(note);
---

<article class="rounded-2xl border border-border bg-surface-raised p-5 shadow-sm">
	<a class="block no-underline" href={`/notes/${slug}/`}>
		<p class="mb-2 text-sm text-muted"><FormattedDate date={note.data.publish_date} /></p>
		<h2 class="text-xl font-bold tracking-tight text-content hover:text-accent">{note.data.title}</h2>
		{note.data.description && <p class="mt-2 text-muted">{note.data.description}</p>}
	</a>
</article>
