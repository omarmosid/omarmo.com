---
import { getEntryTerms } from 'emdash';
import { asDate, entrySlug, type PostEntry } from '../lib/emdash-content';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	post: PostEntry;
}

const { post } = Astro.props;
const slug = entrySlug(post);
const tags = await getEntryTerms('posts', post.id, 'tag');
---

<article class="group rounded-2xl border border-border bg-surface-raised p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md">
	<a class="block no-underline" href={`/posts/${slug}/`}>
		<div class="mb-3 flex items-center gap-2 text-sm text-muted">
			{asDate(post.data.publish_date) && <FormattedDate date={asDate(post.data.publish_date)!} />}
		</div>
		<h2 class="text-xl font-bold tracking-tight text-content group-hover:text-accent">{post.data.title}</h2>
		<p class="mt-2 text-muted">{post.data.description}</p>
	</a>
	{
		tags.length > 0 && (
			<div class="mt-4">
				<TagList tags={tags} />
			</div>
		)
	}
</article>
