---
import { entrySlug, type ProjectEntry } from '../lib/emdash-content';

interface Props {
	project: ProjectEntry;
}

const { project } = Astro.props;
const slug = entrySlug(project);
---

<article class="rounded-2xl border border-border bg-surface-raised p-5 shadow-sm">
	<a class="block no-underline" href={`/projects/${slug}/`}>
		<div class="mb-2 flex items-center gap-2">
			<h2 class="text-xl font-bold tracking-tight text-content hover:text-accent">{project.data.title}</h2>
		</div>
		<p class="mt-2 text-muted">{project.data.description}</p>
	</a>
	{project.data.technologies && project.data.technologies.length > 0 && <p class="mt-4 text-sm text-muted">{project.data.technologies.join(' / ')}</p>}
</article>
