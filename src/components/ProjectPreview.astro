---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
---

<article class="rounded-2xl border border-border bg-surface-raised p-5 shadow-sm">
	<a class="block no-underline" href={`/projects/${project.id}/`}>
		<div class="mb-2 flex items-center gap-2">
			<h2 class="text-xl font-bold tracking-tight text-content hover:text-accent">{project.data.title}</h2>
			{project.data.draft && <span class="rounded-full bg-surface-subtle px-2 py-0.5 text-xs text-muted">Draft</span>}
		</div>
		<p class="mt-2 text-muted">{project.data.description}</p>
	</a>
	{project.data.technologies.length > 0 && <p class="mt-4 text-sm text-muted">{project.data.technologies.join(' / ')}</p>}
</article>
