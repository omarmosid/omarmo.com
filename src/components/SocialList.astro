---
import { SOCIAL_LINKS } from '../consts';
---

<ul class="flex flex-wrap gap-3" aria-label="Social links">
	{
		SOCIAL_LINKS.map((link) => (
			<li>
				<a
					class="inline-flex rounded-full border border-border px-3 py-1.5 text-sm font-medium text-muted no-underline hover:border-accent hover:text-accent"
					href={link.href}
					rel="noreferrer me"
					target="_blank"
				>
					{link.label}
				</a>
			</li>
		))
	}
</ul>
