---
import Moon from 'phosphor-astro/Moon.astro';
import Sun from 'phosphor-astro/Sun.astro';
---

<theme-toggle>
	<button
		class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted no-underline hover:border-accent hover:text-accent"
		type="button"
		aria-label="Toggle theme"
	>
		<Sun class="h-5 w-5 dark:hidden" aria-hidden="true" />
		<Moon class="hidden h-5 w-5 dark:block" aria-hidden="true" />
		<span class="sr-only" data-theme-toggle-label>Toggle theme</span>
	</button>
</theme-toggle>

<script>
	class ThemeToggle extends HTMLElement {
		#storageKey = 'theme';
		#button: HTMLButtonElement | null = null;
		#label: HTMLSpanElement | null = null;

		connectedCallback() {
			this.#button = this.querySelector('button');
			this.#label = this.querySelector('[data-theme-toggle-label]');
			this.#button?.addEventListener('click', this.#toggleTheme);
			this.#updateLabel();
		}

		disconnectedCallback() {
			this.#button?.removeEventListener('click', this.#toggleTheme);
		}

		#getTheme() {
			return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
		}

		#setTheme(theme: 'light' | 'dark') {
			document.documentElement.classList.toggle('dark', theme === 'dark');
			document.documentElement.dataset.theme = theme;

			try {
				localStorage.setItem(this.#storageKey, theme);
			} catch {
				// Ignore storage failures; the current page can still update.
			}
		}

		#toggleTheme = () => {
			this.#setTheme(this.#getTheme() === 'dark' ? 'light' : 'dark');
			this.#updateLabel();
		};

		#updateLabel() {
			const theme = this.#getTheme();
			const nextTheme = theme === 'dark' ? 'light' : 'dark';

			if (this.#label) this.#label.textContent = theme === 'dark' ? 'Dark' : 'Light';
			this.#button?.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
		}
	}

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
