---
/**
 * Labelled form field. The control goes in the default slot and must use `id` as its id,
 * so the label is associated with it.
 */
interface Props {
	id: string;
	label: string;
	optional?: boolean;
}

const { id, label, optional = false } = Astro.props;
---

<div class="grid gap-2">
	<label class="text-sm font-medium text-content" for={id}>
		{label}
		{optional && <span class="ml-1 font-normal text-muted">(optional)</span>}
	</label>
	<slot />
</div>
