---
import { getEntryTerms } from 'emdash';
import { Image } from 'emdash/ui';
import ContentHeader from '../components/ContentHeader.astro';
import TagList from '../components/TagList.astro';
import { asDate, socialImageUrl, type PostEntry } from '../lib/emdash-content';
import Base from './Base.astro';

interface Props {
	post: PostEntry;
	readingTime?: string;
}

const { post, readingTime } = Astro.props;
const { cover_image, description, publish_date, title, updated_date } = post.data;
const coverUrl = socialImageUrl(cover_image, Astro.locals.emdash?.getPublicMediaUrl);
const tags = await getEntryTerms('posts', post.id, 'tag');
---

<Base title={title} description={description} image={coverUrl}>
	{/* max-w-2xl keeps lines to a comfortable ~70 characters at the larger reading size. */}
	<article class="max-w-2xl">
		<ContentHeader kicker="Post" title={title} description={description} date={asDate(publish_date)} readingTime={readingTime} updatedDate={asDate(updated_date)}>
			<TagList slot="meta" tags={tags} />
		</ContentHeader>
		{cover_image && <Image image={cover_image} class="mb-12 w-full h-auto rounded-2xl" />}
		<div class="prose-site sm:prose-lg">
			<slot />
		</div>
		<footer class="mt-16 border-t border-border pt-8">
			<a class="text-sm font-medium text-accent no-underline hover:text-accent-hover" href="/posts/">← All posts</a>
		</footer>
	</article>
</Base>
