---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ContentHeader from '../components/ContentHeader.astro';
import TagList from '../components/TagList.astro';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'post'>;
	readingTime?: string;
}

const { post, readingTime } = Astro.props;
const { coverImage, description, publishDate, tags, title, updatedDate } = post.data;
---

<Base title={title} description={description} image={coverImage?.src}>
	<article>
		<ContentHeader kicker="Post" title={title} description={description} date={publishDate} readingTime={readingTime} updatedDate={updatedDate}>
			<TagList slot="meta" tags={tags} />
		</ContentHeader>
		{coverImage && <Image class="mb-10 rounded-2xl" src={coverImage.src} alt={coverImage.alt} width={1200} height={630} />}
		<div class="prose-site">
			<slot />
		</div>
	</article>
</Base>
