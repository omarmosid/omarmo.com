---
import Chip from '../components/Chip.astro';
import ContentHeader from '../components/ContentHeader.astro';
import { type ProjectEntry } from '../lib/emdash-content';
import Base from './Base.astro';

interface Props {
	project: ProjectEntry;
	readingTime?: string;
}

const { project, readingTime } = Astro.props;
const { description, github_url, live_url, technologies = [], title } = project.data;
---

<Base title={title} description={description}>
	<article>
		<ContentHeader kicker="Project" title={title} description={description} readingTime={readingTime}>
			<div slot="meta" class="space-y-4">
				<div class="flex flex-wrap gap-3 text-sm font-medium">
					{live_url && <a class="text-accent" href={live_url} rel="noreferrer" target="_blank">Live site</a>}
					{github_url && <a class="text-accent" href={github_url} rel="noreferrer" target="_blank">GitHub</a>}
				</div>
				{
					technologies.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{technologies.map((technology) => <Chip>{technology}</Chip>)}
						</div>
					)
				}
			</div>
		</ContentHeader>
		<div class="prose-site">
			<slot />
		</div>
	</article>
</Base>
