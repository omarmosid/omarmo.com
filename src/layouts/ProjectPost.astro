---
import type { CollectionEntry } from 'astro:content';
import Chip from '../components/Chip.astro';
import ContentHeader from '../components/ContentHeader.astro';
import Base from './Base.astro';

interface Props {
	project: CollectionEntry<'project'>;
	readingTime?: string;
}

const { project, readingTime } = Astro.props;
const { description, githubUrl, liveUrl, technologies, title } = project.data;
---

<Base title={title} description={description}>
	<article>
		<ContentHeader kicker="Project" title={title} description={description} readingTime={readingTime}>
			<div slot="meta" class="space-y-4">
				<div class="flex flex-wrap gap-3 text-sm font-medium">
					{liveUrl && <a class="text-accent" href={liveUrl} rel="noreferrer" target="_blank">Live site</a>}
					{githubUrl && <a class="text-accent" href={githubUrl} rel="noreferrer" target="_blank">GitHub</a>}
				</div>
				{
					technologies.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{technologies.map((technology) => <Chip>{technology}</Chip>)}
						</div>
					)
				}
			</div>
		</ContentHeader>
		<div class="prose-site">
			<slot />
		</div>
	</article>
</Base>
