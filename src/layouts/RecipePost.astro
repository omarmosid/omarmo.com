---
import { Image } from 'emdash/ui';
import Chip from '../components/Chip.astro';
import ContentHeader from '../components/ContentHeader.astro';
import { asDate, socialImageUrl, type RecipeEntry } from '../lib/emdash-content';
import Base from './Base.astro';

interface Props {
	recipe: RecipeEntry;
	readingTime?: string;
}

const { recipe, readingTime } = Astro.props;
const { cook_time, cover_image, description, ingredients = [], prep_time, publish_date, servings, title } = recipe.data;
const coverUrl = socialImageUrl(cover_image, Astro.locals.emdash?.getPublicMediaUrl);
---

<Base title={title} description={description} image={coverUrl}>
	<article>
		<ContentHeader kicker="Recipe" title={title} description={description} date={asDate(publish_date)} readingTime={readingTime}>
			<div slot="meta" class="flex flex-wrap gap-2">
				{prep_time && <Chip>Prep {prep_time}</Chip>}
				{cook_time && <Chip>Cook {cook_time}</Chip>}
				{servings && <Chip>Serves {servings}</Chip>}
			</div>
		</ContentHeader>
		{cover_image && <Image image={cover_image} class="mb-10 w-full h-auto rounded-2xl" />}
		{ingredients.length > 0 && <section class="mb-10 rounded-2xl border border-border bg-surface-raised p-5"><h2 class="mb-3 text-xl font-bold">Ingredients</h2><ul class="list-disc space-y-1 pl-5 text-content">{ingredients.map((ingredient) => <li>{ingredient}</li>)}</ul></section>}
		<div class="prose-site">
			<slot />
		</div>
	</article>
</Base>
