---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Chip from '../components/Chip.astro';
import ContentHeader from '../components/ContentHeader.astro';
import Base from './Base.astro';

interface Props {
	recipe: CollectionEntry<'recipe'>;
	readingTime?: string;
}

const { recipe, readingTime } = Astro.props;
const { cookTime, coverImage, description, ingredients, prepTime, publishDate, servings, title } = recipe.data;
---

<Base title={title} description={description} image={coverImage?.src}>
	<article>
		<ContentHeader kicker="Recipe" title={title} description={description} date={publishDate} readingTime={readingTime}>
			<div slot="meta" class="flex flex-wrap gap-2">
				{prepTime && <Chip>Prep {prepTime}</Chip>}
				{cookTime && <Chip>Cook {cookTime}</Chip>}
				{servings && <Chip>Serves {servings}</Chip>}
			</div>
		</ContentHeader>
		{coverImage && <Image class="mb-10 rounded-2xl" src={coverImage.src} alt={coverImage.alt} width={1200} height={630} />}
		{ingredients.length > 0 && <section class="mb-10 rounded-2xl border border-border bg-surface-raised p-5"><h2 class="mb-3 text-xl font-bold">Ingredients</h2><ul class="list-disc space-y-1 pl-5 text-content">{ingredients.map((ingredient) => <li>{ingredient}</li>)}</ul></section>}
		<div class="prose-site">
			<slot />
		</div>
	</article>
</Base>
