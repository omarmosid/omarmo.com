---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="Page not found">
	<section class="py-16">
		<p class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">404</p>
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Page not found</h1>
		<p class="mt-4 text-muted">This page does not exist, or it moved during the site rebuild.</p>
		<a class="mt-8 inline-flex font-medium text-accent" href="/">Go home</a>
	</section>
</Base>
