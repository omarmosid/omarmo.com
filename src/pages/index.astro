---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import Hero from "../components/home/Hero.astro";
import PersonSchema from "../components/home/PersonSchema.astro";
import PostPreview from "../components/PostPreview.astro";
import { asDate, setContentCache, type PostEntry } from "../lib/emdash-content";
import Base from "../layouts/Base.astro";

setContentCache(Astro.response);

const postsResult = await getEmDashCollection("posts", { status: "published" });
if (postsResult.error) return new Response("Failed to load posts", { status: 500 });
const posts = (postsResult.entries as PostEntry[])
  .sort((a, b) => (asDate(b.data.publish_date)?.valueOf() ?? 0) - (asDate(a.data.publish_date)?.valueOf() ?? 0))
  .slice(0, 3);
---

<Base>
  <PersonSchema slot="head" />

  <Hero />

  <section class="mt-20">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-tight">Latest posts</h2>
      <a class="text-sm font-medium text-accent" href="/posts/">All posts</a>
    </div>
    <div class="grid gap-5">
      {posts.map((post) => <PostPreview post={post} />)}
    </div>
  </section>
</Base>
