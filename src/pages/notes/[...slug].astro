---
export const prerender = false;

import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import ContentHeader from '../../components/ContentHeader.astro';
import { asDate, readingTimeFromPortableText, setContentCache, type NoteData } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404 });

const { entry: note, error } = await getEmDashEntry<NoteData>('notes', slug);
if (error) return new Response('Failed to load note', { status: 500 });
if (!note) return new Response(null, { status: 404 });
const readingTime = readingTimeFromPortableText(note.data.content);
---

<Base title={note.data.title} description={note.data.description ?? note.data.title}>
	<article>
		<ContentHeader
			kicker="Note"
			title={note.data.title}
			description={note.data.description}
			date={asDate(note.data.publish_date)}
			readingTime={readingTime}
		/>
		<div class="prose-site">
			<PortableText value={note.data.content} />
		</div>
	</article>
</Base>
