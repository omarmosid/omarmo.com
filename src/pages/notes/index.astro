---
export const prerender = false;

import { getEmDashCollection } from 'emdash';
import NotePreview from '../../components/NotePreview.astro';
import { asDate, setContentCache, type NoteEntry } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const { entries, error } = await getEmDashCollection('notes', { status: 'published' });
if (error) return new Response('Failed to load notes', { status: 500 });
const notes = (entries as NoteEntry[]).sort((a, b) => (asDate(b.data.publish_date)?.valueOf() ?? 0) - (asDate(a.data.publish_date)?.valueOf() ?? 0));
---

<Base title="Notes" description="Short notes by Omar Mo">
	<header class="mb-10">
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Notes</h1>
		<p class="mt-4 text-lg text-muted">Shorter pieces and useful references.</p>
	</header>
	<div class="grid gap-5">
		{notes.map((note) => <NotePreview note={note} />)}
	</div>
</Base>
