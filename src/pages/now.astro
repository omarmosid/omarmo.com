---
export const prerender = true;

import Base from '../layouts/Base.astro';
---

<Base title="Now" description="What Omar Mo is focused on now">
	<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Now</h1>
	<div class="prose-site mt-8">
		<p>This page describes what I've been up to:</p>
		<ul>
			<li>Reading <em>Algorithms to Live By</em></li>
			<li>Playing Far Cry 6</li>
			<li>Learning to drive in the UK</li>
		</ul>
		<p>Last updated: {new Date('2025-08-13').toDateString()}</p>
	</div>
</Base>
