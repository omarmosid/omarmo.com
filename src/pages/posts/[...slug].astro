---
export const prerender = false;

import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTimeFromPortableText, setContentCache, type PostData } from '../../lib/emdash-content';

setContentCache(Astro.response);

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404 });

const { entry: post, error } = await getEmDashEntry<PostData>('posts', slug);
if (error) return new Response('Failed to load post', { status: 500 });
if (!post) return new Response(null, { status: 404 });
const readingTime = readingTimeFromPortableText(post.data.content);
---

<BlogPost post={post} readingTime={readingTime}>
	<PortableText value={post.data.content} />
</BlogPost>
