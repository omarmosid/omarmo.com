---
import { getCollection } from 'astro:content';
import PostPreview from '../../components/PostPreview.astro';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('post', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Base title="Posts" description="Writing by Omar Mo">
	<header class="mb-10">
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Posts</h1>
		<p class="mt-4 text-lg text-muted">Writing about software, work, design, and life.</p>
	</header>
	<div class="grid gap-5">
		{posts.map((post) => <PostPreview post={post} />)}
	</div>
</Base>
