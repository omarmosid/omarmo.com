---
export const prerender = false;

import { getEmDashCollection } from 'emdash';
import PostPreview from '../../components/PostPreview.astro';
import { asDate, setContentCache, type PostEntry } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const { entries, error } = await getEmDashCollection('posts', { status: 'published' });
if (error) return new Response('Failed to load posts', { status: 500 });
const posts = (entries as PostEntry[]).sort(
	(a, b) => (asDate(b.data.publish_date)?.valueOf() ?? 0) - (asDate(a.data.publish_date)?.valueOf() ?? 0),
);
---

<Base title="Posts" description="Writing by Omar Mo">
	<header class="mb-10">
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Posts</h1>
		<p class="mt-4 text-lg text-muted">Writing about software, work, design, and life.</p>
	</header>
	<div class="grid gap-5">
		{posts.map((post) => <PostPreview post={post} />)}
	</div>
</Base>
