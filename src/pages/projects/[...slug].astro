---
export const prerender = false;

import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import ProjectPost from '../../layouts/ProjectPost.astro';
import { readingTimeFromPortableText, setContentCache, type ProjectData } from '../../lib/emdash-content';

setContentCache(Astro.response);

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404 });

const { entry: project, error } = await getEmDashEntry<ProjectData>('projects', slug);
if (error) return new Response('Failed to load project', { status: 500 });
if (!project) return new Response(null, { status: 404 });
const readingTime = readingTimeFromPortableText(project.data.content);
---

<ProjectPost project={project} readingTime={readingTime}>
	<PortableText value={project.data.content} />
</ProjectPost>
