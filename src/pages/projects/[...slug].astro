---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectPost from '../../layouts/ProjectPost.astro';

export async function getStaticPaths() {
	const projects = await getCollection('project', ({ data }) => import.meta.env.DEV || !data.draft);
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
	project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(project);
---

<ProjectPost project={project} readingTime={remarkPluginFrontmatter.minutesRead}>
	<Content />
</ProjectPost>
