---
export const prerender = false;

import { getEmDashCollection } from 'emdash';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { asDate, setContentCache, type ProjectEntry } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const { entries, error } = await getEmDashCollection('projects', { status: 'published' });
if (error) return new Response('Failed to load projects', { status: 500 });
const projects = (entries as ProjectEntry[]).sort(
	(a, b) => Number(b.data.featured) - Number(a.data.featured) || (asDate(b.data.start_date)?.valueOf() ?? 0) - (asDate(a.data.start_date)?.valueOf() ?? 0),
);
---

<Base title="Projects" description="Projects by Omar Mo">
	<header class="mb-10">
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Projects</h1>
		<p class="mt-4 text-lg text-muted">Selected work and experiments.</p>
	</header>
	<div class="grid gap-5">
		{projects.map((project) => <ProjectPreview project={project} />)}
	</div>
</Base>
