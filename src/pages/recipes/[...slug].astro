---
export const prerender = false;

import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import RecipePost from '../../layouts/RecipePost.astro';
import { readingTimeFromPortableText, setContentCache, type RecipeData } from '../../lib/emdash-content';

setContentCache(Astro.response);

const slug = Astro.params.slug;
if (!slug) return new Response(null, { status: 404 });

const { entry: recipe, error } = await getEmDashEntry<RecipeData>('recipes', slug);
if (error) return new Response('Failed to load recipe', { status: 500 });
if (!recipe) return new Response(null, { status: 404 });
const readingTime = readingTimeFromPortableText(recipe.data.content);
---

<RecipePost recipe={recipe} readingTime={readingTime}>
	<PortableText value={recipe.data.content} />
</RecipePost>
