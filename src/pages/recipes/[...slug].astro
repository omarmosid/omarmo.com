---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import RecipePost from '../../layouts/RecipePost.astro';

export async function getStaticPaths() {
	const recipes = await getCollection('recipe', ({ data }) => import.meta.env.DEV || !data.draft);
	return recipes.map((recipe) => ({
		params: { slug: recipe.id.replace(/\/index$/, '') },
		props: { recipe },
	}));
}

interface Props {
	recipe: CollectionEntry<'recipe'>;
}

const { recipe } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(recipe);
---

<RecipePost recipe={recipe} readingTime={remarkPluginFrontmatter.minutesRead}>
	<Content />
</RecipePost>
