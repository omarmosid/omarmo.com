---
export const prerender = false;

import { getEmDashCollection } from 'emdash';
import RecipePreview from '../../components/RecipePreview.astro';
import { asDate, setContentCache, type RecipeEntry } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const { entries, error } = await getEmDashCollection('recipes', { status: 'published' });
if (error) return new Response('Failed to load recipes', { status: 500 });
const recipes = (entries as RecipeEntry[]).sort(
	(a, b) => (asDate(b.data.publish_date)?.valueOf() ?? 0) - (asDate(a.data.publish_date)?.valueOf() ?? 0),
);
---

<Base title="Recipes" description="Recipes by Omar Mo">
	<header class="mb-10">
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Recipes</h1>
		<p class="mt-4 text-lg text-muted">Food and drink recipes I want to keep around.</p>
	</header>
	<div class="grid gap-5">
		{recipes.map((recipe) => <RecipePreview recipe={recipe} />)}
	</div>
</Base>
