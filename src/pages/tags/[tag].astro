---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('post', ({ data }) => import.meta.env.DEV || !data.draft);
	const projects = await getCollection('project', ({ data }) => import.meta.env.DEV || !data.draft);
	const recipes = await getCollection('recipe', ({ data }) => import.meta.env.DEV || !data.draft);
	const tags = [...new Set([...posts, ...projects, ...recipes].flatMap((entry) => entry.data.tags))];

	return tags.map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag!;
const posts = (await getCollection('post', ({ data }) => (import.meta.env.DEV || !data.draft) && data.tags.includes(tag))).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/posts/${entry.id.replace(/\/index$/, '')}/`,
	type: 'Post',
}));
const projects = (await getCollection('project', ({ data }) => (import.meta.env.DEV || !data.draft) && data.tags.includes(tag))).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/projects/${entry.id}/`,
	type: 'Project',
}));
const recipes = (await getCollection('recipe', ({ data }) => (import.meta.env.DEV || !data.draft) && data.tags.includes(tag))).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/recipes/${entry.id.replace(/\/index$/, '')}/`,
	type: 'Recipe',
}));

const entries = [...posts, ...projects, ...recipes];
---

<Base title={`#${tag}`} description={`Content tagged ${tag}`}>
	<header class="mb-10">
		<p class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">Tag</p>
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">#{tag}</h1>
	</header>
	<div class="grid gap-5">
		{entries.map((entry) => <article class="rounded-2xl border border-border bg-surface-raised p-5 shadow-sm">
			<p class="mb-2 text-sm font-medium text-muted">{entry.type}</p>
			<a class="block no-underline" href={entry.href}>
				<h2 class="text-xl font-bold tracking-tight text-content hover:text-accent">{entry.title}</h2>
				<p class="mt-2 text-muted">{entry.description}</p>
			</a>
		</article>)}
	</div>
</Base>
