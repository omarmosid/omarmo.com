---
export const prerender = false;

import { getEmDashCollection, getTerm } from 'emdash';
import { entrySlug, setContentCache, type PostEntry, type ProjectEntry, type RecipeEntry } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const tag = Astro.params.tag!;
const term = await getTerm('tag', tag);
if (!term) return new Response(null, { status: 404 });

const [postResult, projectResult, recipeResult] = await Promise.all([
	getEmDashCollection('posts', { status: 'published', where: { tag } }),
	getEmDashCollection('projects', { status: 'published', where: { tag } }),
	getEmDashCollection('recipes', { status: 'published', where: { tag } }),
]);

if (postResult.error || projectResult.error || recipeResult.error) return new Response('Failed to load tag', { status: 500 });

const posts = (postResult.entries as PostEntry[]).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/posts/${entrySlug(entry)}/`,
	type: 'Post',
}));
const projects = (projectResult.entries as ProjectEntry[]).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/projects/${entrySlug(entry)}/`,
	type: 'Project',
}));
const recipes = (recipeResult.entries as RecipeEntry[]).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description,
	href: `/recipes/${entrySlug(entry)}/`,
	type: 'Recipe',
}));

const entries = [...posts, ...projects, ...recipes];
---

<Base title={`#${term.label}`} description={`Content tagged ${term.label}`}>
	<header class="mb-10">
		<p class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">Tag</p>
		<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">#{term.label}</h1>
	</header>
	<div class="grid gap-5">
		{entries.map((entry) => <article class="rounded-2xl border border-border bg-surface-raised p-5 shadow-sm">
			<p class="mb-2 text-sm font-medium text-muted">{entry.type}</p>
			<a class="block no-underline" href={entry.href}>
				<h2 class="text-xl font-bold tracking-tight text-content hover:text-accent">{entry.title}</h2>
				<p class="mt-2 text-muted">{entry.description}</p>
			</a>
		</article>)}
	</div>
</Base>
