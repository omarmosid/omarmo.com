---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('post', ({ data }) => import.meta.env.DEV || !data.draft);
const projects = await getCollection('project', ({ data }) => import.meta.env.DEV || !data.draft);
const recipes = await getCollection('recipe', ({ data }) => import.meta.env.DEV || !data.draft);

const tags = [...new Set([...posts, ...projects, ...recipes].flatMap((entry) => entry.data.tags))].sort();
---

<Base title="Tags" description="Tags on Omar Mo's website">
	<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Tags</h1>
	<div class="mt-8 flex flex-wrap gap-3">
		{tags.map((tag) => <a class="rounded-full border border-border px-3 py-1.5 text-sm font-medium no-underline hover:border-accent hover:text-accent" href={`/tags/${tag}/`}>#{tag}</a>)}
	</div>
</Base>
