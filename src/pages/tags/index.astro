---
export const prerender = false;

import { getTaxonomyTerms } from 'emdash';
import { setContentCache } from '../../lib/emdash-content';
import Base from '../../layouts/Base.astro';

setContentCache(Astro.response);

const tags = (await getTaxonomyTerms('tag')).sort((a, b) => a.label.localeCompare(b.label));
---

<Base title="Tags" description="Tags on Omar Mo's website">
	<h1 class="text-4xl font-bold tracking-tight text-content sm:text-5xl">Tags</h1>
	<div class="mt-8 flex flex-wrap gap-3">
		{tags.map((tag) => <a class="rounded-full border border-border px-3 py-1.5 text-sm font-medium no-underline hover:border-accent hover:text-accent" href={`/tags/${tag.slug}/`}>#{tag.label}</a>)}
	</div>
</Base>
